# Replace both paths with absolute paths on your computer.
[mcp_servers.ai_team_mcp]
command = 'C:\Program Files\nodejs\node.exe'
args = ['C:\absolute\path\codex-ai-team-router\mcp-server\server.mjs']
startup_timeout_sec = 60

[mcp_servers.ai_team_mcp.env]
QWEN_MCP_BASE_URL = 'https://dashscope.aliyuncs.com/compatible-mode/v1'
DEEPSEEK_MCP_BASE_URL = 'https://api.deepseek.com/anthropic'
XAI_MCP_BASE_URL = 'https://api.x.ai/v1'
AI_TEAM_PROXY_MODE = 'fallback'
# Optional official Grok Build CLI worker. Account auth is intentionally the
# default so enabling it cannot silently spend XAI_API_KEY credit.
AI_TEAM_GROK_BUILD_ENABLED = 'false'
AI_TEAM_GROK_BUILD_AUTH = 'account'
# Optional trusted HTTP/HTTPS proxy. On Windows, scripts/codex-proxy-health.ps1
# can detect and test the current local system proxy without printing its URL.
# Prefer a user/system environment variable if the URL contains credentials.
# AI_TEAM_TRUSTED_PROXY_URL = 'http://127.0.0.1:7890'
OPENROUTER_MCP_BASE_URL = 'https://openrouter.ai/api/v1'
GROQ_MCP_BASE_URL = 'https://api.groq.com/openai/v1'
GEMINI_MCP_BASE_URL = 'https://generativelanguage.googleapis.com/v1beta'
SILICONFLOW_MCP_BASE_URL = 'https://api.siliconflow.cn/v1'
# Optional administrator-controlled OpenAI-compatible endpoint.
# OPENAI_COMPATIBLE_BASE_URL = 'http://127.0.0.1:1234/v1'
# Provider keys stay in user/system environment variables; never paste them here.
# OPENROUTER_API_KEY, GROQ_API_KEY, GEMINI_API_KEY, SILICONFLOW_API_KEY, and
# OPENAI_COMPATIBLE_API_KEY enable budget_route for those providers.
# Free-model availability and limits change. This opt-in is false unless set to true.
AI_TEAM_OPENROUTER_FREE_FALLBACK = 'false'
# Optional verified metadata. Missing capabilities/privacy are intentionally not inferred.
AI_TEAM_MODEL_METADATA_JSON = '{"openrouter:vendor/model":{"capabilities":["code","tools"],"is_zero_data_retention":true,"quality_score":0.8}}'
# AI_TEAM_MODEL_MODE defaults to 'auto'. Set it to 'fixed' only when you
# intentionally want QWEN_MCP_MODEL / DEEPSEEK_MCP_MODEL / XAI_SEARCH_MODEL pinned.
